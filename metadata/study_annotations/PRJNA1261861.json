  "paper": {
    "status": "found",
    "title": "Transcriptome analysis of Aspergillus oryzae RIB40 under chemical stress reveals mechanisms of adaptation to fungistatic compounds of lignocellulosic side streams",
    "authors": "Korpioja ME, Sveholm E, Dilokpimol A, Paasela T, Kovalchuk A",
    "year": 2025,
    "journal": "Biotechnology for Biofuels and Bioproducts",
    "doi": "10.1186/s13068-025-02688-5",
    "pmid": "40781683",
    "pmcid": "PMC12335040",
    "url": "https://doi.org/10.1186/s13068-025-02688-5",
    "access": "full_text",
    "association_evidence": "NCBI elink BioProject->PubMed; the paper's data-availability statement gives GEO series GSE296876.",
    "association_confidence": "high"
  },
  "study_summary": {
    "objective": "Learn how A. oryzae tolerates inhibitors released by lignocellulose pretreatment, to engineer strains that grow on lignocellulosic side streams.",
    "experimental_design": "Pre-grown RIB40 mycelium was moved to Czapek-Dox fructose medium (28 C) with or without an inhibitor at its IC50 and sampled 0, 1, 3, 5 and 24 h later; the atlas holds the control and all five inhibitors: furfural 2.3 mM, HMF 13.5 mM, vanillin 2.6 mM, ferulic acid 6.5 mM and levulinic acid 24.5 mM.",
    "main_finding": "Most inhibitors caused ROS-linked stress with an early shutdown of cell-cycle, ribosome and ER protein-folding pathways, and strong induction of NAD(P)H-dependent oxidoreductases and ABC/MFS efflux transporters; aldehydes (especially HMF) caused the strongest response."
  },
