# Large/temporary data - never committed (see PROJECT_MASTER_SPEC.md section 4/7)
/scratch/
*.sra
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram

# Reference files can be large; keep checksums/config in git, not the payloads
/reference/genome/*
/reference/annotation/*
/reference/transcripts/*
/reference/salmon_index/*
!/reference/**/.gitkeep
!/reference/README.md
# t2g.tsv is small (~380KB) and derived deterministically from the
# transcript FASTA; worth tracking like the other metadata/*.tsv tables.
!/reference/transcripts/t2g.tsv

# FungiDB v71 evidence files (Milestone 1) are large; keep checksums and
# provenance notes in git, not the payloads (same policy as /reference/).
/database/FungiDB_v71/*
!/database/FungiDB_v71/CHECKSUMS.sha256
!/database/FungiDB_v71/PROVENANCE.md

# Local database and generated matrices/results are regenerable from raw data
# + pipeline; keep out of git, but keep the directory structure.
/database/*.duckdb
/matrices/**/*.parquet
/matrices/**/*.tsv.gz

# Same policy for the classification/entropy pipeline outputs (`atlas
# stats genes` / `atlas entropy genes` / `atlas cluster genes`, or the
# gene_expression_classification notebook): tables regenerate
# deterministically from the database, and the diagnostic plots regenerate
# from a notebook re-run -- track the small text/tsv reports and the
# notebook itself, not these binary/generated payloads.
/analysis/**/*.parquet
/analysis/**/*.tsv.gz
/analysis/**/*.png
/results/quant/*
/results/qc/*
/results/logs/*
/results/fetchngs/*
# Colab-produced per-accession outputs (docs/decisions/0004): same
# regenerable-results policy, just a different directory shape than the
# quant/qc/logs split above.
/results/[A-Z]RR*/
/results/colab-drive/*
!/results/**/.gitkeep

# Nextflow's own runtime artifacts when run in-place from the repo root
# (scratch/nextflow-work is the actual work dir, but Nextflow still writes
# these to the launch directory)
.nextflow.log*
.nextflow/
/work/

# Runtime/session state
/runtime/status.json
/runtime/control/*
!/runtime/control/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
